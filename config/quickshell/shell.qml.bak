# Color dinamico
import QtQuick
import Quickshell
import Quickshell.Hyprland
import Quickshell.Services.UPower
import Quickshell.Io
import QtQuick.Controls.Basic
import Quickshell.Bluetooth

ShellRoot {
    id: root
    
    // ==========================================
    // 0. GESTOR DE COLORES (PYWAL)
    // ==========================================
    Item {
        id: theme
        // Colores por defecto (Catppuccin) que se usarán un instante hasta que cargue Pywal
        property color bg: "#2c2c34"
        property color bg_light: "#45475a"
        property color fg: "#ffffff"
        property color fg_dim: "#cdd6f4"
        property color accent: "#1747a9"
        property color success: "#a6e3a1"
        property color error: "#f38ba8"

        // Función auxiliar para aplicar transparencia a los colores dinámicos
        function alpha(colorString, a) {
            let c = Qt.color(colorString);
            return Qt.rgba(c.r, c.g, c.b, a);
        }
    }

    // Lee la caché de colores generada por Pywal
    Process {
        id: pywalLoader
        command: ["sh", "-c", "cat ~/.cache/wal/colors.json 2>/dev/null | tr -d '\n'"]
        running: true // Se autoejecuta al iniciar la barra
        stdout: SplitParser {
            onRead: data => {
                if (data === "") return;
                try {
                    let j = JSON.parse(data);
                    theme.bg = j.special.background;
                    theme.fg = j.special.foreground;
                    theme.bg_light = j.colors.color8;
                    theme.fg_dim = j.colors.color7;
                    theme.accent = j.colors.color4;
                    theme.success = j.colors.color2;
                    theme.error = j.colors.color1;
                } catch(e) {
                    console.log("Error parseando colores de Pywal: " + e)
                }
            }
        }
    }

    // Escucha la señal desde el selector de fondos de pantalla
    IpcHandler {
        target: "main-bar"
        function reloadColors(): void {
            pywalLoader.running = true;
        }
    }

    // ==========================================
    // 1. BARRA PRINCIPAL
    // ==========================================
    PanelWindow {
        id: mainBar
        anchors { top: true; left: true; right: true }
        implicitHeight: 30
        color: 'transparent' 
    
        // ===== INICIO BLOQUE IZQUIERDA: POWER + WORKSPACES + CLIENTES ===== 
        Row {
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            anchors.leftMargin: 10
            spacing: 12

            // --- 1. Icono de Power ---
            Item {
                id: powerModule
                width: 24
                height: 20
                anchors.verticalCenter: parent.verticalCenter

                property var powerActions: [
                    { label: "Bloquear",      icon: "󰌾", command: ["sh", "-c", "qs -p /home/alexg/.config/quickshell/lock/shell.qml -d -n; sleep 0.3; qs ipc -p /home/alexg/.config/quickshell/lock/shell.qml call lock lock"] },
                    { label: "Suspender",     icon: "󰤄", command: ["systemctl", "suspend"] },
                    { label: "Reiniciar",     icon: "󰜉", command: ["systemctl", "reboot"] },
                    { label: "Apagar",        icon: "⏻", command: ["systemctl", "poweroff"] }
                ]

                function closeMenu() {
                    powerPopup.visible = false;
                    powerFocusGrab.active = false;
                }

                function runAction(cmd) {
                    Quickshell.execDetached(cmd);
                    powerModule.closeMenu();
                }

                Text {
                    anchors.centerIn: parent
                    text: "󰣇"
                    color: theme.fg
                    font.pixelSize: 18
                    font.family: "JetBrainsMono Nerd Font"
                    font.bold: true
                    Behavior on color { ColorAnimation { duration: 150 } }
                }

                MouseArea {
                    id: powerMouseArea
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        powerPopup.visible = !powerPopup.visible;
                        if (powerPopup.visible) powerFocusGrab.active = true;
                    }
                }

                PopupWindow {
                    id: powerPopup
                    visible: false
                    color: "transparent"
                    implicitWidth: 170
                    implicitHeight: powerColumn.implicitHeight + 16

                    anchor {
                        item: powerModule
                        edges: Edges.Bottom | Edges.Left
                        gravity: Edges.Bottom | Edges.Right
                        adjustment: PopupAdjustment.None
                        margins.bottom: 4
                    }

                    Rectangle {
                        anchors.fill: parent
                        radius: 10
                        color: theme.bg
                        border.color: theme.bg_light
                        border.width: 1

                        Column {
                            id: powerColumn
                            anchors.centerIn: parent
                            width: parent.width - 16
                            spacing: 4

                            Repeater {
                                model: powerModule.powerActions

                                Rectangle {
                                    width: powerColumn.width
                                    height: 28
                                    radius: 6
                                    color: btnMouse.containsMouse ? theme.alpha(theme.bg_light, 0.5) : "transparent"
                                    Behavior on color { ColorAnimation { duration: 100 } }

                                    Row {
                                        anchors.verticalCenter: parent.verticalCenter
                                        anchors.left: parent.left
                                        anchors.leftMargin: 8
                                        spacing: 8

                                        Text {
                                            text: modelData.icon
                                            color: theme.fg
                                            font.family: "JetBrainsMono Nerd Font"
                                            font.pixelSize: 14
                                            anchors.verticalCenter: parent.verticalCenter
                                        }
                                        Text {
                                            text: modelData.label
                                            color: theme.fg_dim
                                            font.pixelSize: 13
                                            anchors.verticalCenter: parent.verticalCenter
                                        }
                                    }

                                    MouseArea {
                                        id: btnMouse
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: powerModule.runAction(modelData.command)
                                    }
                                }
                            }
                        }
                    }

                    HyprlandFocusGrab {
                        id: powerFocusGrab
                        windows: [ powerPopup ]
                        onCleared: powerPopup.visible = false
                    }
                }
            }

            // --- 2. Workspaces ---
            Item {
                id: workspacesModule
                width: {
                    let extraCount = 0;
                    if (Hyprland.workspaces) {
                        for (var i = 0; i < Hyprland.workspaces.length; i++) {
                            let n = parseInt(Hyprland.workspaces[i].name);
                            if (!isNaN(n) && n > 5) extraCount++;
                        }
                    }
                    if (Hyprland.focusedWorkspace) {
                        let fn = parseInt(Hyprland.focusedWorkspace.name);
                        if (!isNaN(fn) && fn > 5 && extraCount === 0) extraCount = 1;
                    }
                    return (5 + extraCount) * 38;
                }
                height: 20
                anchors.verticalCenter: parent.verticalCenter

                property var kanjiNumbers: ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十"]

                function toKanji(n) {
                    if (n >= 0 && n < workspacesModule.kanjiNumbers.length) return workspacesModule.kanjiNumbers[n];
                    return n.toString();
                }

                Repeater {
                    model: 5
                    Rectangle {
                        property int wsNum: index + 1
                        property bool isActive: Hyprland.focusedWorkspace && parseInt(Hyprland.focusedWorkspace.name) === wsNum

                        x: index * 38
                        width: 32
                        height: 20
                        radius: 0
                        color: isActive ? theme.alpha(theme.fg, 0.3) : theme.alpha(theme.fg, 0.13)

                        Behavior on color { ColorAnimation { duration: 200 } }

                        Text {
                            anchors.centerIn: parent
                            text: workspacesModule.toKanji(wsNum)
                            color: isActive ? theme.fg : theme.fg_dim
                            font.pixelSize: 14
                            font.bold: true
                            font.family: "Noto Sans CJK JP"
                        }

                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: Hyprland.dispatch("workspace " + wsNum)
                        }
                    }
                }

                Repeater {
                    model: Hyprland.workspaces
                    delegate: Loader {
                        id: dynLoader
                        property var modelData: model.modelData
                        property int wsNum: parseInt(modelData.name)
                        
                        active: !isNaN(wsNum) && wsNum > 5
                        visible: active

                        sourceComponent: Rectangle {
                            width: 32
                            height: 20
                            radius: 0
                            x: {
                                let indexOffset = 5;
                                if (Hyprland.workspaces) {
                                    let counted = 0;
                                    for (var j = 0; j < Hyprland.workspaces.length; j++) {
                                        let n = parseInt(Hyprland.workspaces[j].name);
                                        if (!isNaN(n) && n > 5) {
                                            if (n === wsNum) break;
                                            counted++;
                                        }
                                    }
                                    indexOffset += counted;
                                }
                                return indexOffset * 38;
                            }
                            z: modelData.active ? 100 : wsNum
                            color: modelData.active ? theme.alpha(theme.fg, 0.3) : theme.alpha(theme.fg, 0.13)

                            Behavior on color { ColorAnimation { duration: 200 } }
                            Behavior on x { NumberAnimation { duration: 200; easing.type: Easing.OutExpo } }

                            Text {
                                anchors.centerIn: parent
                                text: workspacesModule.toKanji(wsNum)
                                color: modelData.active ? theme.fg : theme.fg_dim
                                font.bold: true
                                font.family: "Noto Sans CJK JP"
                            }

                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: modelData.activate()
                            }
                        }
                    }
                }
            }

            // --- 3. Módulo de Aplicaciones Activas ---
            Item {
                id: clientListModule
                height: 20
                anchors.verticalCenter: parent.verticalCenter
                width: clientRow.width

                property var currentClients: []

                Process {
                    id: clientsProc
                    command: ["sh", "-c", "hyprctl clients -j | jq -c --arg ws \"" + (Hyprland.focusedWorkspace ? Hyprland.focusedWorkspace.name : "1") + "\" '[.[] | select(.workspace.name == $ws)]'"]
                    running: true
                    stdout: SplitParser {
                        onRead: data => {
                            try {
                                let json = JSON.parse(data.trim());
                                if (Array.isArray(json)) clientListModule.currentClients = json;
                            } catch(e) { clientListModule.currentClients = []; }
                        }
                    }
                }

                Timer {
                    interval: 300
                    running: true
                    repeat: true
                    onTriggered: { if (!clientsProc.running) clientsProc.running = true; }
                }

                Row {
                    id: clientRow
                    spacing: 6
                    anchors.verticalCenter: parent.verticalCenter

                    Repeater {
                        model: clientListModule.currentClients

                        delegate: Rectangle {
                            width: 24
                            height: 20
                            radius: 4
                            color: clientMouse.containsMouse ? theme.bg_light : theme.bg
                            border.color: modelData.focused ? theme.accent : theme.bg_light
                            border.width: 1

                            Behavior on color { ColorAnimation { duration: 100 } }

                            Text {
                                anchors.centerIn: parent
                                text: {
                                    let cls = modelData.class ? modelData.class.toLowerCase() : "";
                                    if (cls.includes("brave")) return "";
                                    if (cls.includes("code")) return "󰨞";
                                    if (cls.includes("kitty") || cls.includes("alacritty")) return "󰆍";
                                    if (cls.includes("discord")) return "";
                                    if (cls.includes("spotify")) return "󰓇";
                                    if (cls.includes("whatsapp web")) return "󰖣";
                                    if (cls.includes("obsidian")) return "";
                                    if (cls.includes("eclipse")) return "";
                                    if (cls.includes("yazi") || cls.includes("thunar")) return "";
                                    if (cls.includes("steam")) return "";
                                    if (cls.includes("modrinth")) return "󰍳";
                                    if (cls.includes("writer")) return "";
                                    if (cls.includes("calc")) return "󱎏";
                                    return "󰣆";
                                }
                                color: modelData.focused ? theme.fg : theme.fg_dim
                                font.pixelSize: 14
                                font.family: "JetBrainsMono Nerd Font"
                            }

                            MouseArea {
                                id: clientMouse
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: Quickshell.execDetached(["hyprctl", "dispatch", "focuswindow", "address:" + modelData.address]);
                            }
                        }
                    }
                }
            }
        }
        // ===== FIN BLOQUE IZQUIERDA =====

        // --- CENTRO: RELOJ Y CLIMA ---
        Row {
            anchors.centerIn: parent
            spacing: 15 

            Text {
                color: theme.fg
                font.pixelSize: 15
                font.bold: true
                anchors.verticalCenter: parent.verticalCenter
                function updateTime() { text = Qt.formatTime(new Date(), "hh:mm") }
                Component.onCompleted: updateTime()
                Timer { interval: 1000; running: true; repeat: true; onTriggered: parent.updateTime() }
            }

            Row {
                id: weatherModule
                spacing: 5
                anchors.verticalCenter: parent.verticalCenter
                
                Text {
                    id: weatherIcon
                    text: "" 
                    color: theme.fg
                    font.pixelSize: 15
                    anchors.verticalCenter: parent.verticalCenter
                }

                Text {
                    id: weatherText
                    text: "..."
                    color: theme.fg
                    font.pixelSize: 15
                    font.bold: true
                    anchors.verticalCenter: parent.verticalCenter
                }

                function updateWeather() {
                    var req = new XMLHttpRequest();
                    req.open("GET", "http://wttr.in/?format=%C|%t");
                    req.setRequestHeader("User-Agent", "curl/7.81.0");
                    
                    req.onreadystatechange = function() {
                        if (req.readyState === XMLHttpRequest.DONE && req.status === 200) {
                            var parts = req.responseText.trim().split("|");
                            if (parts.length >= 2) {
                                var condition = parts[0].toLowerCase();
                                weatherText.text = parts[1].replace("+", ""); 
                                
                                if (condition.indexOf("clear") !== -1 || condition.indexOf("sunny") !== -1) weatherIcon.text = ""; 
                                else if (condition.indexOf("rain") !== -1 || condition.indexOf("drizzle") !== -1 || condition.indexOf("shower") !== -1) weatherIcon.text = ""; 
                                else if (condition.indexOf("snow") !== -1 || condition.indexOf("ice") !== -1) weatherIcon.text = ""; 
                                else if (condition.indexOf("thunder") !== -1 || condition.indexOf("storm") !== -1) weatherIcon.text = ""; 
                                else if (condition.indexOf("fog") !== -1 || condition.indexOf("mist") !== -1) weatherIcon.text = ""; 
                                else weatherIcon.text = ""; 
                            }
                        }
                    }
                    req.send();
                }

                Component.onCompleted: weatherModule.updateWeather()

                Timer {
                    interval: 1800000
                    running: true
                    repeat: true
                    onTriggered: weatherModule.updateWeather()
                }
            }
        }

        // --- DERECHA: MODULOS DE SISTEMA ---
        Row {
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            anchors.rightMargin: 10
            spacing: 15

            // --- Modulo de Volumen ---
            Item {
                id: volumeModule
                width: volumeRow.width
                height: volumeRow.height
                anchors.verticalCenter: parent.verticalCenter

                property int volume: 0
                property bool muted: false

                function volumeIcon() {
                    if (volumeModule.muted || volumeModule.volume === 0) return "󰝟";
                    else if (volumeModule.volume < 30) return "󰕿";
                    else if (volumeModule.volume < 70) return "󰖀";
                    else return "󰕾";
                }

                function refreshVolume() { getVolumeProcess.running = true; }

                function setVolumeAbsolute(pct) {
                    pct = Math.max(0, Math.min(100, Math.round(pct)));
                    volumeModule.volume = pct;
                    volumeModule.muted = false;
                    setVolumeProcess.command = ["sh", "-c", "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ " + (pct / 100).toFixed(2)];
                    setVolumeProcess.running = true;
                }

                function adjustVolume(deltaPct) {
                    var dir = deltaPct > 0 ? "+" : "-";
                    var step = Math.abs(deltaPct);
                    setVolumeProcess.command = ["sh", "-c", "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ " + step + "%" + dir];
                    setVolumeProcess.running = true;
                    volumeModule.volume = Math.max(0, Math.min(100, volumeModule.volume + deltaPct));
                }

                Row {
                    id: volumeRow
                    spacing: 5
                    anchors.verticalCenter: parent.verticalCenter

                    Text {
                        text: volumeModule.volumeIcon()
                        color: theme.fg
                        font.pixelSize: 18
                        font.family: "JetBrainsMono Nerd Font"
                        font.bold: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                    Text {
                        text: volumeModule.muted ? "" : volumeModule.volume + "%"
                        color: theme.fg
                        font.pixelSize: 15
                        font.bold: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                }

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    acceptedButtons: Qt.LeftButton
                    onClicked: {
                        volumePopup.visible = !volumePopup.visible;
                        if (volumePopup.visible) {
                            volumeModule.refreshVolume();
                            volumeFocusGrab.active = true;
                        }
                    }
                    onWheel: (wheel) => {
                        if (wheel.angleDelta.y > 0) volumeModule.adjustVolume(2);
                        else volumeModule.adjustVolume(-2);
                    }
                }

                Process {
                    id: getVolumeProcess
                    command: ["sh", "-c", "wpctl get-volume @DEFAULT_AUDIO_SINK@"]
                    running: false
                    stdout: SplitParser {
                        onRead: data => {
                            let line = data.trim();
                            let muted = line.indexOf("MUTED") !== -1;
                            let match = line.match(/[\d.]+/);
                            if (match) {
                                volumeModule.volume = Math.round(parseFloat(match[0]) * 100);
                                volumeModule.muted = muted;
                            }
                        }
                    }
                }

                Process {
                    id: setVolumeProcess
                    running: false
                    onRunningChanged: if (!running) volumeModule.refreshVolume()
                }

                Timer {
                    interval: 100
                    running: true
                    repeat: true
                    onTriggered: volumeModule.refreshVolume()
                }

                Component.onCompleted: volumeModule.refreshVolume()

                PopupWindow {
                    id: volumePopup
                    visible: false
                    color: "transparent"
                    implicitWidth: 200
                    implicitHeight: 56

                    anchor {
                        item: volumeModule
                        edges: Edges.Bottom
                        gravity: Edges.Bottom
                        adjustment: PopupAdjustment.None
                        margins.bottom: -8
                    }

                    Rectangle {
                        anchors.fill: parent
                        radius: 0
                        color: theme.alpha(theme.bg, 0.6)
                        border.color: theme.alpha(theme.fg, 0.2)
                        border.width: 1

                        Slider {
                            id: volumeSlider
                            anchors.centerIn: parent
                            width: parent.width - 30
                            from: 0
                            to: 100
                            value: volumeModule.volume
                            onMoved: volumeModule.setVolumeAbsolute(value)

                            background: Rectangle {
                                x: volumeSlider.leftPadding
                                y: volumeSlider.topPadding + volumeSlider.availableHeight / 2 - height / 2
                                width: volumeSlider.availableWidth
                                height: 6
                                radius: 3
                                color: theme.alpha(theme.fg, 0.2)

                                Rectangle {
                                    width: volumeSlider.visualPosition * parent.width
                                    height: parent.height
                                    radius: 3
                                    color: theme.accent
                                }
                            }

                            handle: Rectangle {
                                x: volumeSlider.leftPadding + volumeSlider.visualPosition * (volumeSlider.availableWidth - width)
                                y: volumeSlider.topPadding + volumeSlider.availableHeight / 2 - height / 2
                                width: 16
                                height: 16
                                radius: 8
                                color: volumeSlider.pressed ? theme.fg_dim : theme.fg
                                border.color: theme.accent
                                border.width: 2
                            }
                        }
                    }

                    HyprlandFocusGrab {
                        id: volumeFocusGrab
                        windows: [ volumePopup ]
                        onCleared: volumePopup.visible = false
                    }
                }
            }

            // --- Módulo de Bluetooth ---
            Item {
                id: bluetoothModule
                width: btRow.width
                height: 20
                anchors.verticalCenter: parent.verticalCenter

                readonly property var adapter: Bluetooth.defaultAdapter
                readonly property bool btEnabled: bluetoothModule.adapter ? bluetoothModule.adapter.enabled : false

                Row {
                    id: btRow
                    spacing: 5
                    anchors.verticalCenter: parent.verticalCenter

                    Text {
                        text: bluetoothModule.btEnabled ? "󰂯" : "󰂲"
                        color: theme.fg
                        font.pixelSize: 18
                        font.family: "JetBrainsMono Nerd Font"
                        font.bold: true
                        anchors.verticalCenter: parent.verticalCenter
                    }
                }

                MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                        bluetoothPopup.visible = !bluetoothPopup.visible;
                        if (bluetoothPopup.visible) bluetoothFocusGrab.active = true;
                    }
                }

                PopupWindow {
                    id: bluetoothPopup
                    visible: false
                    color: "transparent"
                    implicitWidth: 240
                    implicitHeight: bluetoothColumn.implicitHeight + 20

                    anchor {
                        item: bluetoothModule
                        edges: Edges.Bottom
                        gravity: Edges.Bottom
                        adjustment: PopupAdjustment.None
                        margins.bottom: 4
                    }

                    Rectangle {
                        anchors.fill: parent
                        radius: 10
                        color: theme.alpha(theme.bg, 0.6)
                        border.color: theme.alpha(theme.fg, 0.2)
                        border.width: 1

                        Column {
                            id: bluetoothColumn
                            anchors.top: parent.top
                            anchors.horizontalCenter: parent.horizontalCenter
                            anchors.topMargin: 10
                            width: parent.width - 20
                            spacing: 10

                            Item {
                                width: parent.width
                                height: 24

                                Text {
                                    text: "Bluetooth"
                                    color: theme.fg
                                    font.pixelSize: 14
                                    font.bold: true
                                    anchors.left: parent.left
                                    anchors.verticalCenter: parent.verticalCenter
                                }

                                Rectangle {
                                    id: btSwitch
                                    width: 40
                                    height: 22
                                    radius: 11
                                    anchors.right: parent.right
                                    anchors.verticalCenter: parent.verticalCenter
                                    color: bluetoothModule.btEnabled ? theme.accent : theme.alpha(theme.fg, 0.2)
                                    Behavior on color { ColorAnimation { duration: 150 } }

                                    Rectangle {
                                        width: 18
                                        height: 18
                                        radius: 9
                                        color: theme.fg
                                        anchors.verticalCenter: parent.verticalCenter
                                        x: bluetoothModule.btEnabled ? parent.width - width - 2 : 2
                                        Behavior on x { NumberAnimation { duration: 150; easing.type: Easing.OutExpo } }
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            if (bluetoothModule.adapter) {
                                                bluetoothModule.adapter.enabled = !bluetoothModule.adapter.enabled;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: parent.width
                                height: 1
                                color: theme.alpha(theme.fg, 0.2)
                                visible: bluetoothModule.btEnabled
                            }

                            Column {
                                width: parent.width
                                spacing: 4
                                visible: bluetoothModule.btEnabled

                                Text {
                                    text: (bluetoothModule.adapter && bluetoothModule.adapter.devices.values.length > 0) ? "Dispositivos" : "Sin dispositivos emparejados"
                                    color: theme.fg_dim
                                    font.pixelSize: 11
                                }

                                Repeater {
                                    model: bluetoothModule.adapter ? bluetoothModule.adapter.devices.values : []

                                    Rectangle {
                                        width: parent.width
                                        height: 28
                                        radius: 6
                                        color: deviceMouse.containsMouse ? theme.alpha(theme.fg, 0.2) : "transparent"
                                        Behavior on color { ColorAnimation { duration: 100 } }

                                        Text {
                                            anchors.verticalCenter: parent.verticalCenter
                                            anchors.left: parent.left
                                            anchors.leftMargin: 8
                                            text: (modelData.connected ? "󰂱 " : "󰂯 ") + modelData.name
                                            color: modelData.connected ? theme.success : theme.fg
                                            font.pixelSize: 12
                                            font.family: "JetBrainsMono Nerd Font"
                                        }

                                        MouseArea {
                                            id: deviceMouse
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: modelData.connected = !modelData.connected
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HyprlandFocusGrab {
                        id: bluetoothFocusGrab
                        windows: [ bluetoothPopup ]
                        onCleared: bluetoothPopup.visible = false
                    }
                }
            }

            // --- Módulo de Red ---
            Row {
                id: netModule
                spacing: 8

                property int signalStrength: 100
                property string wifiIcon: "󰤨"
                property string ssidName: "..."

                function updateWifiIcon(signal) {
                    if (signal > 80) return "󰤨";      
                    else if (signal > 60) return "󰤥"; 
                    else if (signal > 40) return "󰤢"; 
                    else if (signal > 20) return "󰤟"; 
                    else if (signal > 0) return "󰤯";  
                    else return "󰤮";                 
                }

                Text {
                    text: netModule.wifiIcon
                    color: theme.fg
                    font.pixelSize: 18
                    font.family: "JetBrainsMono Nerd Font"
                    anchors.verticalCenter: parent.verticalCenter
                }

                Text {
                    text: netModule.ssidName
                    color: theme.fg
                    font.pixelSize: 15
                    font.bold: true
                    anchors.verticalCenter: parent.verticalCenter
                    elide: Text.ElideRight
                    width: Math.min(implicitWidth, 140)
                }

                Process {
                    id: netProcess
                    command: ["bash", "-c", "iface=$(ip route 2>/dev/null | awk '/default/ {print $5}' | head -n1); [ -z \"$iface\" ] && iface='wlan0'; link=$(iw dev \"$iface\" link 2>/dev/null); ssid=$(echo \"$link\" | awk -F': ' '/SSID/ {print $2}'); dbm=$(echo \"$link\" | awk '/signal:/ {print $2}'); if [ -z \"$ssid\" ]; then ssid='Sin conexión'; sig=0; else if [ -n \"$dbm\" ]; then sig=$(( (dbm + 100) * 2 )); [ $sig -lt 0 ] && sig=0; [ $sig -gt 100 ] && sig=100; else sig=100; fi; fi; echo \"$sig|$ssid\""]
                    running: false

                    stdout: SplitParser {
                        onRead: data => {
                            let line = data.trim();
                            let parts = line.split("|");
                            if (parts.length >= 2) {
                                let sig = parseInt(parts[0]);
                                let ssid = parts[1];

                                if (!isNaN(sig)) {
                                    netModule.signalStrength = sig;
                                    netModule.wifiIcon = netModule.updateWifiIcon(sig);
                                }
                                netModule.ssidName = ssid;
                            }
                        }
                    }
                }

                Timer {
                    interval: 100
                    running: true
                    repeat: true
                    onTriggered: {
                        if (!netProcess.running) {
                            netProcess.running = true;
                        }
                    }
                }

                Component.onCompleted: netProcess.running = true
            }

            // --- Modulo de RAM ---
            Row {
                spacing: 5
                
                Text {
                    text: "" 
                    color: theme.fg
                    font.pixelSize: 16
                    font.family: "JetBrainsMono Nerd Font"
                    anchors.verticalCenter: parent.verticalCenter
                }
                
                Text {
                    id: ramText
                    text: "..." 
                    color: theme.fg
                    font.pixelSize: 15
                    font.bold: true
                    anchors.verticalCenter: parent.verticalCenter
                }

                Process {
                    id: ramProcess
                    command: ["sh", "-c", "free | awk '/Mem:/ {print int($3/$2 * 100)}'"]
                    running: false
                    stdout: SplitParser {
                        onRead: data => {
                            let val = data.trim();
                            if (val !== "" && !isNaN(val)) ramText.text = val + "%";
                        }
                    }
                }

                Timer {
                    interval: 5000
                    running: true
                    repeat: true
                    onTriggered: { if (!ramProcess.running) ramProcess.running = true; }
                }
            }

            // --- Modulo de CPU ---
            Row {
                spacing: 5
                
                Text {
                    text: "" 
                    color: theme.fg
                    font.pixelSize: 16
                    font.family: "JetBrainsMono Nerd Font"
                    anchors.verticalCenter: parent.verticalCenter
                }
                
                Text {
                    id: cpuText
                    text: "..." 
                    color: theme.fg
                    font.pixelSize: 15
                    font.bold: true
                    anchors.verticalCenter: parent.verticalCenter
                }

                Process {
                    id: cpuProcess
                    command: ["sh", "-c", "awk 'NR==1 {u1=$2+$3+$4; t1=$2+$3+$4+$5+$6+$7+$8} NR==2 {u2=$2+$3+$4; t2=$2+$3+$4+$5+$6+$7+$8; print int((u2-u1)*100/(t2-t1))}' <(grep '^cpu ' /proc/stat) <(sleep 1; grep '^cpu ' /proc/stat)"]
                    running: false
                    stdout: SplitParser {
                        onRead: data => {
                            let val = data.trim();
                            if (val !== "" && !isNaN(val)) cpuText.text = val + "%";
                        }
                    }
                }

                Timer {
                    interval: 2000
                    running: true
                    repeat: true
                    onTriggered: { if (!cpuProcess.running) cpuProcess.running = true; }
                }
            }

            // --- Módulo de Batería ---
            Row {
                spacing: 8
                anchors.verticalCenter: parent.verticalCenter

                Text {
                    id: batteryText
                    color: theme.fg
                    font.pixelSize: 15
                    font.bold: true
                    anchors.verticalCenter: parent.verticalCenter
                    text: Math.round(UPower.displayDevice.percentage * 100) + "%"
                }

                Item {
                    width: 24
                    height: 11
                    anchors.verticalCenter: parent.verticalCenter

                    property real pct: UPower.displayDevice.percentage 
                    property bool isCharging: UPower.displayDevice.state === 1 || UPower.displayDevice.state === 4

                    Rectangle {
                        anchors.left: parent.left
                        anchors.verticalCenter: parent.verticalCenter
                        width: 21
                        height: 11
                        radius: 3.5
                        color: theme.alpha(theme.fg, 0.13)
                        border.color: theme.fg_dim
                        border.width: 1

                        Rectangle {
                            id: fillRect
                            anchors.left: parent.left
                            anchors.top: parent.top
                            anchors.bottom: parent.bottom
                            anchors.margins: 2
                            width: Math.max(0, (parent.width - 4) * parent.parent.pct)
                            radius: 2
                            color: parent.parent.isCharging ? theme.success : (parent.parent.pct <= 0.2 ? theme.error : theme.fg)

                            Behavior on width { NumberAnimation { duration: 200 } }
                        }
                    }

                    Rectangle {
                        anchors.right: parent.right
                        anchors.verticalCenter: parent.verticalCenter
                        width: 2
                        height: 5
                        radius: 1
                        color: theme.fg_dim
                    }
                }
            }
        }
    }
}